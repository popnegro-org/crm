    id         String                       @id(map: "slackWorkspaceGrant_pkey")
    teamId     String
    teamName   String?
    userToken  String
    userScopes String
    createdAt  DateTime(storage: timestamp) @default(now())
    updatedAt  DateTime(storage: timestamp) @onCreate(now()) @onUpdate(now())

    @@index([teamId], map: "slackWorkspaceGrant_teamId_key", unique: true)
    @@map("slackWorkspaceGrant")
  }

  model SsoProvider {
    id             String  @id(map: "ssoProvider_pkey")
    issuer         String
    oidcConfig     String?
    samlConfig     String?
    userId         String?
    providerId     String
    organizationId String?
    domain         String
    user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ssoProvider_userId_fkey", index: false)

    @@index([providerId], map: "ssoProvider_providerId_key", unique: true)
    @@map("ssoProvider")
  }

  model SuppressedContact {
    email     String                       @id(map: "suppressedContact_pkey")
    reason    String?
    createdAt DateTime(storage: timestamp) @default(now())

    @@map("suppressedContact")
  }

  model SuppressedDomain {
    domain    String                       @id(map: "suppressedDomain_pkey")
    reason    String?
    createdAt DateTime(storage: timestamp) @default(now())

    @@map("suppressedDomain")
  }

  model TelemetryCounter {
    name      String                       @id(map: "telemetryCounter_pkey")
    count     Int                          @default(0)
    updatedAt DateTime(storage: timestamp) @onCreate(now()) @onUpdate(now())

    @@map("telemetryCounter")
  }

  model TelemetryMilestone {
    step      String                       @id(map: "telemetryMilestone_pkey")
    reachedAt DateTime(storage: timestamp) @default(now())

    @@map("telemetryMilestone")
  }

  model TrackedDomain {
    id         String                        @id(map: "trackedDomain_pkey")
    host       String
    scope      pg.enum(DomainScope)          @default("EXACT_HOST")
    pageViews  Int                           @default(0)
    lastSeenAt DateTime(storage: timestamp)?
    createdAt  DateTime(storage: timestamp)  @default(now())

    @@index([host], map: "trackedDomain_host_key", unique: true)
    @@map("trackedDomain")
  }

  model TrackedEvent {
    id         String                       @id(map: "trackedEvent_pkey")
    visitorId  String
    _type      String                       @map("type")
    host       String
    path       String
    referrer   String?
    label      String?
    occurredAt DateTime(storage: timestamp)
    source     String?
    medium     String?
    campaign   String?

    @@index([host, occurredAt], map: "trackedEvent_host_occurredAt_idx")
    @@index([occurredAt], map: "trackedEvent_occurredAt_idx")
    @@index([source, occurredAt], map: "trackedEvent_source_occurredAt_idx")
    @@index([visitorId, occurredAt], map: "trackedEvent_visitorId_occurredAt_idx")
    @@map("trackedEvent")
  }

  model TrackedPageDaily {
    day      DateTime(storage: timestamp)
    host     String
    path     String
    views    Int                          @default(0)
    visitors Int                          @default(0)

    @@id([day, host, path], map: "trackedPageDaily_pkey")
    @@index([host, day], map: "trackedPageDaily_host_day_idx")
    @@map("trackedPageDaily")
  }

  model TrackedVisitor {
    id            String                        @id(map: "trackedVisitor_pkey")
    contactId     String?
    firstSeen     DateTime(storage: timestamp)  @default(now())
    lastSeen      DateTime(storage: timestamp)
    firstSource   String?
    firstMedium   String?
    firstCampaign String?
    firstTerm     String?
    firstContent  String?
    firstReferrer String?
    firstLanding  String?
    firstTouchAt  DateTime(storage: timestamp)?
    lastSource    String?
    lastMedium    String?
    lastCampaign  String?
    lastTerm      String?
    lastContent   String?
    lastReferrer  String?
    lastLanding   String?
    lastTouchAt   DateTime(storage: timestamp)?
    contact       Contact?                      @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "trackedVisitor_contactId_fkey")

    @@index([contactId], map: "trackedVisitor_contactId_idx")
    @@index([firstSource], map: "trackedVisitor_firstSource_idx")
    @@map("trackedVisitor")
  }

  model TrackingCounter {
    key       String                       @id(map: "trackingCounter_pkey")
    value     Int                          @default(0)
    expiresAt DateTime(storage: timestamp)

    @@index([expiresAt], map: "trackingCounter_expiresAt_idx")
    @@map("trackingCounter")
  }

  model Verification {
    id         String                       @id(map: "verification_pkey")
    identifier String
    value      String
    expiresAt  DateTime(storage: timestamp)
    createdAt  DateTime(storage: timestamp) @default(now())
    updatedAt  DateTime(storage: timestamp) @onCreate(now()) @onUpdate(now())

    @@index([identifier], map: "verification_identifier_idx")
    @@map("verification")
  }

  model WorkspaceProfile {
    id          String                       @id(map: "workspaceProfile_pkey")
    website     String
    narrative   String
    sections    Jsonb
    sourceUrl   String?
    sessionId   String?
    refreshedAt DateTime(storage: timestamp) @default(now())

    @@map("workspaceProfile")
  }

